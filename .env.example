# Public Supabase credentials: dedicated staging project only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend database login. Never add NEXT_PUBLIC_ to this value.
DATABASE_URL=
DB_SSL=require
APP_ORIGIN=http://localhost:3000
# Exact provider hostnames, comma separated. Empty means deny all.
RPC_ALLOWED_HOSTS=
# Backend-only EVM chain -> trusted RPC URL map; never supplied by the caller.
WALLET_CHAIN_RPC_JSON={}
MONITOR_REGION=
# New alert channels require manual operator ownership verification.
ALERT_ENCRYPTION_KEY=
ALERT_ALLOWED_EMAILS=
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Requires BOTH allowlisted ID and app_metadata.nazu_admin=true.
ADMIN_USER_IDS=
NEXT_TELEMETRY_DISABLED=1
